# Local: SQLite is fine
# Production (Railway): inject automatically when you add the Postgres plugin
DATABASE_URL=sqlite:///./parkblast.db

# Free tier from openweathermap.org — sign up, copy key here
OPENWEATHER_API_KEY=

# Production: MUST be your exact Vercel URL — never use * in production
# Local: http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
